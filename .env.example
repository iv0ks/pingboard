# Copy to .env for local runs. docker compose reads this file.

# --- Postgres (the `postgres` service) ---
POSTGRES_USER=pingboard
POSTGRES_PASSWORD=pingboard
POSTGRES_DB=pingboard

# --- App ---
# Inside the compose network the DB host is the service name `postgres`.
DATABASE_URL=postgres://pingboard:pingboard@postgres:5432/pingboard
SESSION_SECRET=dev-only-insecure-secret-change-me
PORT=3000

# --- Traefik ACME (DNS-01 via Namecheap). Only needed if you use Traefik. ---
# NAMECHEAP_API_USER=
# NAMECHEAP_API_KEY=

# Root path for the Traefik config bind mount (defaults to repo root).
# ROOT_PATH=.
